# ==============================================================================
# LearnAI environment configuration
# Copy this file to .env and fill in your values: cp .env.example .env
# Variables marked [required] must be set for the app to start.
# Everything else degrades gracefully (the related feature is disabled).
# ==============================================================================

# ------------------------------------------------------------------------------
# Core [required]
# ------------------------------------------------------------------------------
# PostgreSQL connection string (Supabase, Neon, RDS, or local Postgres)
DATABASE_URL="postgresql://user:password@localhost:5432/learnai"
# Direct (non-pooled) connection, used by Prisma migrations. Same as
# DATABASE_URL when you're not behind a connection pooler.
DIRECT_URL="postgresql://user:password@localhost:5432/learnai"

# Secret for signing JWT auth tokens. Generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=""

# Public URL of the app (used in emails, share links, OAuth callbacks)
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# ------------------------------------------------------------------------------
# AI providers (at least one recommended — powers quizzes, summaries, tutoring)
# ------------------------------------------------------------------------------
# Which provider to prefer: openai | gemini | groq
AI_PROVIDER="openai"
OPENAI_API_KEY=""
ANTHROPIC_API_KEY=""
GEMINI_API_KEY=""
GROQ_API_KEY=""

# ------------------------------------------------------------------------------
# Auth — Google OAuth (optional)
# ------------------------------------------------------------------------------
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# ------------------------------------------------------------------------------
# Payments — Stripe (optional)
# ------------------------------------------------------------------------------
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=""
NEXT_PUBLIC_STRIPE_PRICE_BASIC=""
NEXT_PUBLIC_STRIPE_PRICE_STANDARD=""
NEXT_PUBLIC_STRIPE_PRICE_PREMIUM=""

# ------------------------------------------------------------------------------
# Storage — AWS S3 for video upload (optional)
# ------------------------------------------------------------------------------
AWS_REGION="us-east-1"
AWS_ACCESS_KEY_ID=""
AWS_SECRET_ACCESS_KEY=""
AWS_S3_BUCKET=""

# ------------------------------------------------------------------------------
# Rate limiting — Upstash Redis (optional, strongly recommended in production;
# without it rate limiting is disabled and a warning is logged)
# ------------------------------------------------------------------------------
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""

# ------------------------------------------------------------------------------
# External content — YouTube import & transcripts (optional)
# ------------------------------------------------------------------------------
YOUTUBE_API_KEY=""
SUPADATA_API_KEY=""

# ------------------------------------------------------------------------------
# Media metadata — TMDB (optional)
# ------------------------------------------------------------------------------
TMDB_TOKEN=""
NEXT_PUBLIC_TMDB_IMAGE="https://image.tmdb.org/t/p"

# ------------------------------------------------------------------------------
# Blockchain badges — Hedera + IPFS via Pinata (optional)
# ------------------------------------------------------------------------------
HEDERA_ACCOUNT_ID=""
HEDERA_PRIVATE_KEY=""
HEDERA_BADGE_CONTRACT=""
PINATA_JWT=""

# ------------------------------------------------------------------------------
# Monitoring — Sentry (optional)
# ------------------------------------------------------------------------------
SENTRY_DSN=""
NEXT_PUBLIC_SENTRY_DSN=""
SENTRY_ORG=""
SENTRY_PROJECT=""
SENTRY_AUTH_TOKEN=""

# ------------------------------------------------------------------------------
# Email (optional — verification emails are logged to console if unset)
# ------------------------------------------------------------------------------
EMAIL_PROVIDER=""

# ------------------------------------------------------------------------------
# Scheduled jobs (optional — protects /api/cron/* endpoints; Vercel Cron sends
# it automatically as "Authorization: Bearer <CRON_SECRET>")
# ------------------------------------------------------------------------------
CRON_SECRET=""

# ------------------------------------------------------------------------------
# Misc
# ------------------------------------------------------------------------------
DEMO_CONTENT_ID=""
